# --- LLM Provider: "ollama" or "openai" ---
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3.5:9B

# --- OpenAI (cloud) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embedding (OpenAI) ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval & Chunking ---
TOP_K=5
CHUNK_SIZE=400
CHUNK_OVERLAP=60
